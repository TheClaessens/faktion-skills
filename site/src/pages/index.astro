---
/**
 * Custom homepage, outside the Starlight documentation layout.
 * Copy lives in `src/lib/homepage.ts`.
 */
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow/latin-ext-400.css';
import '@fontsource/barlow/latin-ext-600.css';
import '../styles/tokens.css';
import CopyCommand from '../components/CopyCommand.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { command, identity, onward, secondaryLinks } from '../lib/homepage';
import { withSiteBase } from '../lib/site-path';

const faviconHref = withSiteBase('/favicon.svg');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{identity.title}</title>
		<meta name="description" content={identity.what} />
		<meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
		<link rel="icon" href={faviconHref} type="image/svg+xml" />
		<script is:inline>
			(function () {
				var stored =
					typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
				var theme =
					stored === 'light' || stored === 'dark'
						? stored
						: window.matchMedia('(prefers-color-scheme: light)').matches
							? 'light'
							: 'dark';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body>
		<SiteHeader />
		<main id="content">
			<header class="identity">
				<p class="identity__eyebrow">{identity.eyebrow}</p>
				<h1 class="identity__title">{identity.title}</h1>
				<p class="identity__what">{identity.what}</p>
				<p class="identity__who">{identity.who}</p>
			</header>

			<section class="command" aria-labelledby="command-heading">
				<h2 id="command-heading" class="command__heading">{command.heading}</h2>
				<CopyCommand value={command.value} />
				<p class="command__note">{command.note}</p>
			</section>

			<nav class="onward" aria-label="Start here">
				<ul class="onward__list">
					{
						onward.map((link) => (
							<li>
								<a class="onward__link" href={withSiteBase(link.path)}>
									<span class="onward__label">{link.label}</span>
									<span class="onward__blurb">{link.blurb}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="also" aria-labelledby="also-heading">
				<h2 id="also-heading" class="also__heading">{secondaryLinks.heading}</h2>
				<ul class="also__list">
					{
						secondaryLinks.links.map((link) => (
							<li>
								<a class="also__link" href={withSiteBase(link.path)}>
									<span class="also__label">{link.label}</span>
									<span class="also__blurb">{link.blurb}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</main>
	</body>
</html>

<style>
	* {
		box-sizing: border-box;
	}

	html {
		font-size: 100%;
		color-scheme: light dark;
		background: var(--paper);
	}

	body {
		margin: 0;
		min-height: 100dvh;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--font-sans);
		line-height: 1.55;
	}

	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 1.75rem 1.25rem 4rem;
	}

	.identity {
		margin-bottom: 2rem;
	}

	.identity__eyebrow {
		margin: 0 0 0.65rem;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--muted);
	}

	.identity__title {
		margin: 0 0 1rem;
		font-size: clamp(1.75rem, 5vw, 2.4rem);
		line-height: 1.12;
		letter-spacing: -0.035em;
		font-weight: 700;
		overflow-wrap: anywhere;
	}

	.identity__what,
	.identity__who,
	.command__note {
		margin: 0 0 1rem;
		font-size: 1.0625rem;
	}

	.identity__who {
		color: var(--muted);
	}

	.command {
		margin: 0 0 2rem;
		padding: 1.25rem 0 1.25rem 1rem;
		border-left: 3px solid var(--accent);
		border-top: none;
		border-bottom: none;
	}

	.command__heading,
	.also__heading {
		margin: 0 0 0.75rem;
		font-size: 1rem;
		font-weight: 600;
		color: var(--ink);
	}

	.command__note {
		margin: 0.85rem 0 0;
		color: var(--muted);
	}

	.onward__list,
	.also__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.onward__list li,
	.also__list li {
		border-bottom: 1px solid var(--line);
	}

	.onward__list li:last-child,
	.also__list li:last-child {
		border-bottom: none;
	}

	.onward__link,
	.also__link {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.85rem 0;
		min-height: 2.75rem;
		color: inherit;
		text-decoration: none;
	}

	.onward__label,
	.also__label {
		font-weight: 600;
		color: var(--accent);
	}

	.onward__blurb,
	.also__blurb {
		color: var(--muted);
		font-size: 0.95rem;
	}

	.onward__link:focus-visible,
	.also__link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.also {
		margin-top: 2rem;
	}

	@media (min-width: 40rem) {
		main {
			padding: 2rem 1.75rem 5rem;
		}

		.identity__title {
			max-width: 18ch;
			text-wrap: balance;
		}

		.onward__list {
			grid-template-columns: 1fr 1fr;
			gap: 1rem 1.5rem;
		}

		.onward__list li {
			border-bottom: none;
		}

		.onward__link {
			border: 1px solid var(--line);
			border-radius: var(--radius);
			padding: 1rem;
			min-height: 100%;
			background: var(--paper-raised);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.identity,
		.command,
		.onward,
		.also {
			animation: rise 0.7s var(--ease) both;
		}

		.command {
			animation-delay: 80ms;
		}

		.onward {
			animation-delay: 140ms;
		}

		.also {
			animation-delay: 200ms;
		}

		.onward__label,
		.also__label,
		.onward__link,
		.also__link {
			transition:
				color 180ms var(--ease),
				border-color 180ms var(--ease),
				transform 180ms var(--ease),
				background-color 180ms var(--ease);
		}

		.onward__link:hover,
		.also__link:hover {
			transform: translateY(-1px);
		}

		.onward__link:hover {
			border-color: var(--accent);
		}

		.onward__link:active,
		.also__link:active {
			transform: scale(0.98);
		}
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 39.99rem) {
		main {
			padding-inline: 1rem;
		}
	}
</style>
