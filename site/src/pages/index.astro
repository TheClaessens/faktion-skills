---
/**
 * Custom homepage, outside the Starlight documentation layout.
 * Copy lives in `src/lib/homepage.ts` so a later visual design pass can
 * restyle this route without re-authoring the orientation.
 */
import { command, identity, onward, secondaryLinks } from '../lib/homepage';
import { withSiteBase } from '../lib/site-path';

const faviconHref = withSiteBase('/favicon.svg');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{identity.title}</title>
		<meta name="description" content={identity.what} />
		<link rel="icon" href={faviconHref} type="image/svg+xml" />
	</head>
	<body>
		<main>
			<header class="identity">
				<p class="identity__eyebrow">{identity.eyebrow}</p>
				<h1 class="identity__title">{identity.title}</h1>
				<p class="identity__what">{identity.what}</p>
				<p class="identity__who">{identity.who}</p>
			</header>

			<section class="command" aria-labelledby="command-heading">
				<h2 id="command-heading" class="command__heading">{command.heading}</h2>
				<p class="command__value"><code>{command.value}</code></p>
				<p class="command__note">{command.note}</p>
			</section>

			<nav class="onward" aria-label="Start here">
				<ul class="onward__list">
					{
						onward.map((link) => (
							<li>
								<a class="onward__link" href={withSiteBase(link.path)}>
									<span class="onward__label">{link.label}</span>
									<span class="onward__blurb">{link.blurb}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="also" aria-labelledby="also-heading">
				<h2 id="also-heading" class="also__heading">{secondaryLinks.heading}</h2>
				<ul class="also__list">
					{
						secondaryLinks.links.map((link) => (
							<li>
								<a class="also__link" href={withSiteBase(link.path)}>
									<span class="also__label">{link.label}</span>
									<span class="also__blurb">{link.blurb}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
		--bg: light-dark(#f7f5f2, #16151a);
		--fg: light-dark(#1c1917, #f4f0ea);
		--muted: light-dark(#57534e, #c4b8ab);
		--accent: light-dark(#1d4ed8, #93c5fd);
		--code-bg: light-dark(#ece8e3, #2a2724);
		--line: light-dark(#d6d0c8, #3a3530);
	}

	* {
		box-sizing: border-box;
	}

	html {
		font-size: 100%;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--fg);
		font-family:
			ui-sans-serif,
			system-ui,
			-apple-system,
			Segoe UI,
			sans-serif;
		line-height: 1.55;
	}

	main {
		max-width: 40rem;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem;
	}

	.identity {
		margin-bottom: 2rem;
	}

	.identity__eyebrow {
		margin: 0 0 0.75rem;
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.identity__title {
		margin: 0 0 1rem;
		font-size: clamp(1.75rem, 5vw, 2.25rem);
		line-height: 1.2;
		font-weight: 650;
	}

	.identity__what,
	.identity__who,
	.command__note {
		margin: 0 0 1rem;
		font-size: 1.0625rem;
	}

	.identity__who {
		color: var(--muted);
	}

	.command {
		margin: 0 0 2rem;
		padding: 1.25rem 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.command__heading,
	.also__heading {
		margin: 0 0 0.75rem;
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-weight: 650;
		color: var(--muted);
	}

	.command__value {
		margin: 0 0 0.75rem;
	}

	.command__value code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: clamp(1.125rem, 4vw, 1.5rem);
		background: var(--code-bg);
		padding: 0.2em 0.45em;
		border-radius: 0.25rem;
		overflow-wrap: anywhere;
	}

	.command__note {
		margin-bottom: 0;
	}

	.onward__list,
	.also__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.onward__list li,
	.also__list li {
		border-bottom: 1px solid var(--line);
	}

	.onward__list li:last-child,
	.also__list li:last-child {
		border-bottom: none;
	}

	.onward__link,
	.also__link {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.85rem 0;
		min-height: 2.75rem;
		color: inherit;
		text-decoration: none;
	}

	.onward__label,
	.also__label {
		font-weight: 650;
		color: var(--accent);
	}

	.onward__blurb,
	.also__blurb {
		color: var(--muted);
		font-size: 0.95rem;
	}

	.onward__link:focus-visible,
	.also__link:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
	}

	.also {
		margin-top: 2rem;
	}

	@media (min-width: 40rem) {
		main {
			padding-top: 4.5rem;
		}

		.onward__list {
			grid-template-columns: 1fr 1fr;
			gap: 1rem 1.5rem;
		}

		.onward__list li {
			border-bottom: none;
		}

		.onward__link {
			border: 1px solid var(--line);
			border-radius: 0.4rem;
			padding: 1rem;
			min-height: 100%;
		}
	}
</style>
