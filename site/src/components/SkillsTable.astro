---
import { loadInventory } from '../lib/content';
import { PM_PLUGIN_ROOT } from '../lib/plugin-root';
import {
	invocationLabel,
	skillPageHref,
	withSiteBase,
} from '../lib/skill-pages';

const inventory = loadInventory(PM_PLUGIN_ROOT);
---

<p>
	Plugin version <strong>{inventory.version}</strong>, read from the plugin
	manifest at build time.
</p>

<table>
	<thead>
		<tr>
			<th>Skill</th>
			<th>Description</th>
			<th>How it is invoked</th>
		</tr>
	</thead>
	<tbody>
		{
			inventory.skills.map((skill) => (
				<tr>
					<td>
						<a href={withSiteBase(skillPageHref(skill))}>
							<code>{skill.name}</code>
						</a>
					</td>
					<td>{skill.description}</td>
					<td>{invocationLabel(skill.invocation)}</td>
				</tr>
			))
		}
	</tbody>
</table>
