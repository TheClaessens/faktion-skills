---
import { requireSkill } from '../lib/content';
import { PM_PLUGIN_ROOT } from '../lib/plugin-root';
import { skillPageHref } from '../lib/skill-pages';
import { withSiteBase } from '../lib/site-path';

interface Props {
	name: string;
	slash?: boolean;
}

const { name, slash = false } = Astro.props;
const skill = requireSkill(PM_PLUGIN_ROOT, name);

const href = withSiteBase(skillPageHref(skill));
const label = slash ? `/${name}` : name;
---

<a href={href}><code>{label}</code></a>
